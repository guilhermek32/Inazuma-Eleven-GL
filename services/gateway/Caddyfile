# Public gateway: the only container with published ports.
#
# SITE_ADDRESS selects the mode:
#   :80                 plain HTTP (local `docker compose up`)
#   game.example.com    automatic HTTPS (Let's Encrypt) for a real deployment
#
# Routes
#   /ws/game/<match_id>  WebSocket upgrade, proxied to the match runtime
#   /api/lobby/v1/*      lobby public API (prefix /api/lobby stripped)
#   /api/stats/v1/*      results public reads (prefix /api/stats stripped)
#   /api/recommendations/v1/*  recommendation public reads (prefix stripped)
#   /api/status/v1/<svc> up/down of one microservice (gateway, lobby,
#                        match-runtime, ai-bot, results, recommendation): its
#                        /health is probed and only {"service","status"} is
#                        returned, never the internal health body
#   /api/*               404: internal APIs are never routed
#   /healthz             gateway liveness (public)
#
# A second, internal listener (127.0.0.1:8081, plain HTTP in both modes)
# answers /healthz for the container healthcheck: with a domain in
# SITE_ADDRESS, port 80 only redirects to HTTPS, which a local wget can't follow.
#   everything else      the Godot web export (static files)
#
# The web export is single-threaded, so COOP/COEP headers are not required.

{
	admin off
}

# Status probe of one microservice: (name, upstream host:port).
# 2xx from its /health -> 200 {"status":"up"}; any other answer -> 503
# {"status":"down"}; unreachable -> the site's handle_errors (also 503 down).
(service_status) {
	handle /api/status/v1/{args[0]} {
		rewrite * /health
		reverse_proxy {args[1]} {
			@up status 2xx
			handle_response @up {
				header Content-Type application/json
				respond `{"service":"{args[0]}","status":"up"}` 200
			}
			handle_response {
				header Content-Type application/json
				respond `{"service":"{args[0]}","status":"down"}` 503
			}
		}
	}
}

http://:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
	respond 404
}

{$SITE_ADDRESS::80} {
	log {
		output stdout
		format json
	}

	# The standard encode handler offers zstd and gzip (no dynamic Brotli in the
	# stock image). Its default type list omits the Godot pack and wasm-adjacent
	# types, so match them explicitly.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/wasm*
			header Content-Type application/octet-stream*
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /ws/game/* {
		reverse_proxy match-runtime:8910
	}

	handle /api/lobby/v1/* {
		uri strip_prefix /api/lobby
		reverse_proxy lobby:8000
	}

	handle /api/stats/v1/* {
		uri strip_prefix /api/stats
		reverse_proxy results:8000
	}

	handle /api/recommendations/v1/* {
		uri strip_prefix /api/recommendations
		reverse_proxy recommendation:8000
	}

	handle /api/status/v1/gateway {
		header Content-Type application/json
		respond `{"service":"gateway","status":"up"}` 200
	}
	import service_status lobby lobby:8000
	import service_status match-runtime match-runtime:8911
	import service_status ai-bot ai-bot:8920
	import service_status results results:8000
	import service_status recommendation recommendation:8000

	# A stopped service's container name no longer resolves: answer "down".
	handle_errors {
		@status path /api/status/v1/*
		handle @status {
			header Content-Type application/json
			respond `{"status":"down"}` 503
		}
	}

	# Nothing else under /api is public: the runtime control API and the
	# results ingestion endpoint stay on the internal network.
	handle /api/* {
		header Content-Type application/json
		respond `{"error":"not_found"}` 404
	}

	handle {
		@pck path *.pck
		header @pck Content-Type application/octet-stream
		root * /srv/web
		file_server
	}
}
