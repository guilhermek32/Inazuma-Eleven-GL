# Secrets for docker compose. Copy to .env (which git ignores) and replace
# every value before deploying; compose refuses to start while one is unset.
# Generate values with e.g. `openssl rand -hex 32`. Keep the database
# passwords URL-safe (letters, digits, - _), they end up in connection URLs.

# HMAC key of the match credentials: shared by the lobby (signs) and the
# match runtime (verifies).
MATCH_SECRET=change-me-match-secret

# Bearer token the lobby presents to the match runtime's internal control API.
RUNTIME_CONTROL_TOKEN=change-me-runtime-control-token

# Bearer token the match runtime presents to the results service's ingestion API.
RESULTS_INGEST_TOKEN=change-me-results-ingest-token

# PostgreSQL superuser, and the per-service roles created on first start.
POSTGRES_PASSWORD=change-me-postgres
LOBBY_DB_PASSWORD=change-me-lobby-db
RESULTS_DB_PASSWORD=change-me-results-db

# Optional: public domain for automatic HTTPS, and the published ports.
# SITE_ADDRESS=game.example.com
# GATEWAY_HTTP_PORT=8080
# GATEWAY_HTTPS_PORT=8443
